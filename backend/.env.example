# Copy to backend/.env and fill in your keys.

APP_ENV=development

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Docker default (see docker-compose.yml at the repo root):
#   docker compose up -d postgres redis
DATABASE_URL=postgresql+psycopg://pageone:pageone@127.0.0.1:5433/pageone
REDIS_URL=redis://127.0.0.1:6379/0

# For Neon / any hosted Postgres, paste the connection string.
# postgresql://... is rewritten to postgresql+psycopg:// automatically.

SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Empty in development: Secure is off unless you set 1.
# Production sets Secure automatically when APP_ENV=production.
COOKIE_SECURE=0

# Web process in production: JOBS_SWEEP_DISABLE=1
# Worker process: leave unset.
JOBS_SWEEP_DISABLE=

# Optional. Forgot/reset links are logged when this is empty.
RESEND_API_KEY=
EMAIL_FROM=Page one <noreply@localhost>

# Optional. Hide the Google button when empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
